<button id="scrollTop" type="button" aria-label="Scroll to top" title="Scroll to top">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5"></path><path d="M5 12l7-7 7 7"></path>
  </svg>
</button>

<script>
/* ---------- fibre track: dark fibre fills with light on scroll ---------- */
(function(){
  var track     = document.querySelector('.fiber-track');
  var vLine     = document.getElementById('verticalLine');
  var container = document.getElementById('timeline-container');
  var shell     = document.querySelector('.node-section.shell');
  var nodes     = Array.prototype.slice.call(document.querySelectorAll('.fiber-node'));
  var indices   = Array.prototype.slice.call(document.querySelectorAll('.node-index'));
  var finalNode = document.querySelector('.fiber-final-node');
  var finalBar  = document.querySelector('.fiber-final-bar');
  var endMarker = document.querySelector('.timeline-end');
  var finalEndpoint = 0;

  function hex2rgb(h){h=h.replace('#','');return [parseInt(h.substr(0,2),16),parseInt(h.substr(2,2),16),parseInt(h.substr(4,2),16)];}
  function lerpColor(a,b,t){
    var A=hex2rgb(a),B=hex2rgb(b);
    return 'rgb('+Math.round(A[0]+(B[0]-A[0])*t)+','+Math.round(A[1]+(B[1]-A[1])*t)+','+Math.round(A[2]+(B[2]-A[2])*t)+')';
  }
  var C_TOP='#cccccc', C_BOT='#0099cc';   /* dark fibre -> lit */
  var nodeColors = nodes.map(function(_,i){
    return lerpColor(C_TOP,C_BOT, nodes.length>1 ? i/(nodes.length-1) : 0);
  });

  function layout(){
    if(!track || !container || !shell) return;
    var cRect = container.getBoundingClientRect();
    var sRect = shell.getBoundingClientRect();
    var vw = document.documentElement.clientWidth;
    var gap = 64, nodeBleed = 16, minGapNeeded = 96;
    if (vw - sRect.right < minGapNeeded){
      track.style.display = 'none';
    } else {
      track.style.display = '';
      track.style.left = Math.min(sRect.right - cRect.left + gap, (vw - nodeBleed) - cRect.left) + 'px';
    }
    track.style.height = cRect.height + 'px';

    var tRect = track.getBoundingClientRect();
    indices.forEach(function(idx,i){
      if(!nodes[i]) return;
      var r = idx.getBoundingClientRect();
      nodes[i].style.top = (r.top + r.height/2 - tRect.top - 13) + 'px';
    });

    if(endMarker && finalNode && finalBar){
      var top = endMarker.getBoundingClientRect().top - tRect.top;
      finalEndpoint = top;
      finalNode.style.top = (top - 15) + 'px';
      finalBar.style.top  = (top - 2.5) + 'px';
      finalBar.dataset.fullWidth = 200;
    }
    update();
  }

  var bendPlayed = false;
  function playFinalBend(){
    if(bendPlayed) return;
    bendPlayed = true;
    finalNode.classList.add('is-on');
    finalBar.style.width = (finalBar.dataset.fullWidth || 200) + 'px';
  }
  function resetFinalBend(){
    if(!bendPlayed) return;
    bendPlayed = false;
    finalNode.classList.remove('is-on');
    finalBar.style.width = '0px';
  }

  function update(){
    if(!track || !finalEndpoint) return;
    var scrollable = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
    var frac = Math.min(1, Math.max(0, window.scrollY / scrollable));
    vLine.style.height = (frac * finalEndpoint) + 'px';

    indices.forEach(function(idx,i){
      if(!nodes[i]) return;
      var r = idx.getBoundingClientRect();
      if(r.top < window.innerHeight * 0.85 && r.bottom > 0){
        nodes[i].classList.add('is-on');
        nodes[i].style.background = nodeColors[i];
        nodes[i].style.boxShadow = '0 0 16px 2px ' + nodeColors[i];
      }else{
        nodes[i].classList.remove('is-on');
        nodes[i].style.background = '';
        nodes[i].style.boxShadow = 'none';
      }
    });

    if(frac >= 0.999) playFinalBend(); else resetFinalBend();
  }

  var ticking = false;
  window.addEventListener('scroll', function(){
    if(ticking) return;
    ticking = true;
    requestAnimationFrame(function(){ update(); ticking = false; });
  }, {passive:true});
  window.addEventListener('resize', layout);
  window.addEventListener('load', layout);
  document.addEventListener('DOMContentLoaded', layout);
  if(document.fonts && document.fonts.ready){ document.fonts.ready.then(layout); }
  if(window.ResizeObserver){ new ResizeObserver(layout).observe(document.body); }
  layout();
})();

/* ---------- scroll to top ---------- */
(function(){
  var btn = document.getElementById('scrollTop');
  if(!btn) return;
  function onScroll(){
    btn.classList.toggle('show', window.scrollY > window.innerHeight * 0.6);
  }
  btn.addEventListener('click', function(){ window.scrollTo({top:0, behavior:'smooth'}); });
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
})();

/* ---------- hero: reveal the scroll cue after the first pass;
              honour reduced-motion by holding the poster frame ---------- */
(function(){
  var video = document.querySelector('.hero-video-wrap video');
  var cue   = document.querySelector('.scroll-cue');
  if(!video) return;

  if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    video.removeAttribute('autoplay');
    video.pause();
    if(cue) cue.classList.add('show');
    return;
  }
  if(!cue) return;
  var lastTime = 0, looped = false;
  video.addEventListener('timeupdate', function(){
    if(!looped && video.currentTime < lastTime - 0.5){ looped = true; cue.classList.add('show'); }
    lastTime = video.currentTime;
  });
  video.addEventListener('ended', function(){ cue.classList.add('show'); });
})();
</script>

